---
import { SITE_NAME, FULL_ADDRESS } from '../data/site';

const currentYear = new Date().getFullYear();
const legalLinks = [
	{ href: '/wettelijke-vermeldingen', label: 'Wettelijke vermeldingen' },
	{ href: '/privacybeleid', label: 'Privacybeleid' },
	{ href: '/cookiebeleid', label: 'Cookiebeleid' },
];
---

<footer class="footer">
	<div class="container footer-inner">
		<div class="footer-main">
			<p>&copy; {currentYear} {SITE_NAME} &middot; {FULL_ADDRESS}</p>
			<nav class="legal-nav" aria-label="Wettelijke informatie">
				{legalLinks.map((link, i) => (
					<>
						{i > 0 && <span aria-hidden="true"> &middot; </span>}
						<a href={link.href}>{link.label}</a>
					</>
				))}
			</nav>
		</div>
		<p class="credit">
			Website door&nbsp;<a href="https://www.coopconsult.be" target="_blank" rel="noopener">Coop Consult</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-dark);
		color: rgba(255, 255, 255, 0.7);
		padding: 28px 0;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		align-items: flex-end;
		gap: 14px;
		font-size: 0.88rem;
	}

	.footer-main {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.legal-nav a {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.82rem;
	}

	.legal-nav a:hover {
		color: #fff;
	}

	.credit a {
		font-weight: 800;
		color: var(--color-accent);
	}

	.credit a:hover {
		text-decoration: underline;
	}
</style>
