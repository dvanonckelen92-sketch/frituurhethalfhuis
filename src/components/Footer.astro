---
import { SITE_NAME, FULL_ADDRESS } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="footer">
	<div class="container footer-inner">
		<p>&copy; {currentYear} {SITE_NAME} &middot; {FULL_ADDRESS}</p>
		<p class="credit">
			Website door&nbsp;<a href="https://www.coopconsult.be" target="_blank" rel="noopener">Coop Consult</a>
		</p>
	</div>
</footer>

<style>
	.footer {
		background: var(--color-dark);
		color: rgba(255, 255, 255, 0.7);
		padding: 28px 0;
	}

	.footer-inner {
		display: flex;
		flex-wrap: wrap;
		justify-content: space-between;
		gap: 10px;
		font-size: 0.88rem;
	}

	.credit a {
		font-weight: 800;
		color: var(--color-accent);
	}

	.credit a:hover {
		text-decoration: underline;
	}
</style>
