---
import { Image } from 'astro:assets';
import ingang from '../assets/photos/ingang.jpg';

const ORDER_URL = 'https://frituurhethalfhuis.pickandgo.be/';
const FB_URL = 'https://www.facebook.com/profile.php?id=61583588097751';
const EMAIL = 'frituurhethalfhuis@gmail.com';
---

<section class="section cta-section" id="contact">
	<div class="container cta-grid">
		<div class="cta-image">
			<Image src={ingang} alt="Ingang van Frituur Het Halfhuis" width={560} height={420} />
		</div>

		<div class="cta-text">
			<span class="eyebrow">Contact</span>
			<h2>Langsgaan of bestellen</h2>
			<p>
				Kies je tijdslot in de webshop en haal je bestelling af langs de linkse deur op
				Borlostraat 15.
			</p>

			<div class="cta-actions">
				<a class="btn btn-primary" href={ORDER_URL} target="_blank" rel="noopener">
					Bestel online
				</a>
				<a class="btn btn-ghost" href={FB_URL} target="_blank" rel="noopener">
					Facebook
				</a>
			</div>

			<div class="cta-contact">
				<a href={`mailto:${EMAIL}`}>{EMAIL}</a>
				<span>Borlostraat 15, 3891 Mielen-Boven-Aalst</span>
			</div>
		</div>
	</div>
</section>

<style>
	.cta-section {
		background: var(--color-bg-alt);
		border-top: 1px solid var(--color-border);
	}

	.cta-grid {
		display: grid;
		grid-template-columns: 0.9fr 1.1fr;
		gap: 56px;
		align-items: center;
	}

	.cta-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		object-fit: cover;
		aspect-ratio: 4 / 3;
	}

	.cta-text h2 {
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		margin: 14px 0 16px;
	}

	.cta-text p {
		color: var(--color-text-muted);
		max-width: 440px;
	}

	.cta-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.cta-contact {
		margin-top: 26px;
		display: flex;
		flex-direction: column;
		gap: 6px;
		font-weight: 700;
		font-size: 0.95rem;
		color: var(--color-text-muted);
	}

	.cta-contact a:hover {
		color: var(--color-primary-dark);
	}

	@media (max-width: 860px) {
		.cta-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.cta-image {
			order: -1;
			max-width: 420px;
		}
	}
</style>
