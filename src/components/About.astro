---
import { Image } from 'astro:assets';
import ownerPhoto from '../assets/photos/eigenares.jpg';
import { FULL_ADDRESS } from '../data/site';
---

<section class="section" id="over-ons">
	<div class="container about-grid">
		<div class="about-image">
			<Image src={ownerPhoto} alt="De eigenares van Frituur Het Halfhuis bij de frietbakken" width={560} height={720} />
		</div>

		<div class="about-text">
			<span class="eyebrow">Over ons</span>
			<h2>Over de frituur</h2>
			<p>
				Frituur Het Halfhuis zit aan de Borlostraat in Mielen-Boven-Aalst, deelgemeente van
				Gingelom. Op de kaart staan frieten, snacks, Bicky burgers en huisgemaakt stoofvlees,
				allemaal klaargemaakt op het moment dat je bestelt.
			</p>
			<p>
				Bestel op voorhand via de webshop en kies je afhaalmoment, of spring gewoon binnen om
				af te halen.
			</p>

			<ul class="about-list">
				<li>Frieten, snacks en Bicky burgers</li>
				<li>Huisgemaakt stoofvlees en stoofvleessaus</li>
				<li>Online bestellen en afhalen op een tijdslot naar keuze</li>
				<li>{FULL_ADDRESS}</li>
			</ul>
		</div>
	</div>
</section>

<style>
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 340px) 1fr;
		gap: 56px;
		align-items: center;
	}

	.about-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		object-fit: cover;
		aspect-ratio: 4 / 5;
	}

	.about-text h2 {
		font-size: clamp(1.7rem, 3vw, 2.2rem);
		margin: 14px 0 18px;
	}

	.about-text p {
		color: var(--color-text-muted);
		margin-bottom: 14px;
	}

	.about-list {
		list-style: none;
		padding: 0;
		margin: 22px 0 0;
		display: grid;
		gap: 10px;
	}

	.about-list li {
		font-weight: 600;
		font-size: 0.95rem;
		padding: 10px 0;
		border-bottom: 1px solid var(--color-border);
	}

	@media (max-width: 860px) {
		.about-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.about-image {
			max-width: 320px;
		}
	}
</style>
