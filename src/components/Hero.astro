---
const ORDER_URL = 'https://frituurhethalfhuis.pickandgo.be/';
const HERO_IMAGE =
	'https://images.unsplash.com/photo-1688978181542-87a886a16fbe?auto=format&fit=crop&w=1600&q=80';
---

<section class="hero" id="top">
	<img class="hero-bg" src={HERO_IMAGE} alt="Krokante verse frietjes van Frituur Het Halfhuis" loading="eager" />
	<div class="hero-overlay"></div>

	<div class="container hero-content">
		<span class="eyebrow eyebrow-light">☆ Familiefrituur in Mielen-Boven-Aalst ☆</span>
		<h1>
			Verse frietjes,<br />
			met liefde gebakken.
		</h1>
		<p class="lead">
			Bij Frituur Het Halfhuis draait het om eerlijke frietjes, krokante snacks en Bicky
			burgers &mdash; klaargemaakt terwijl je wacht en zo warm mogelijk meegegeven.
		</p>

		<div class="hero-actions">
			<a class="btn btn-primary" href={ORDER_URL} target="_blank" rel="noopener">
				🛵 Bestel &amp; haal af
			</a>
			<a class="btn btn-ghost" href="#menu">Bekijk het menu</a>
		</div>

		<div class="hero-status" id="hero-status">
			<span class="dot" id="status-dot"></span>
			<span id="status-text">Openingsuren laden…</span>
		</div>
	</div>
</section>

<script>
	type Hours = { hours: string[] };
	const schedule: Hours[] = [
		{ hours: ['11:30-13:30', '16:30-21:00'] }, // 0 zondag
		{ hours: ['16:30-21:00'] }, // 1 maandag
		{ hours: [] }, // 2 dinsdag
		{ hours: ['11:30-13:30', '16:30-21:00'] }, // 3 woensdag
		{ hours: ['16:30-21:00'] }, // 4 donderdag
		{ hours: ['16:30-21:00'] }, // 5 vrijdag
		{ hours: ['16:30-21:00'] }, // 6 zaterdag
	];

	function toMinutes(t: string) {
		const [h, m] = t.split(':').map(Number);
		return h * 60 + m;
	}

	function computeStatus() {
		const now = new Date();
		const day = now.getDay();
		const nowMin = now.getHours() * 60 + now.getMinutes();
		const todayRanges = schedule[day].hours;

		for (const range of todayRanges) {
			const [start, end] = range.split('-');
			if (nowMin >= toMinutes(start) && nowMin < toMinutes(end)) {
				return { open: true, text: `Nu open · tot ${end}` };
			}
			if (nowMin < toMinutes(start)) {
				return { open: false, text: `Nu gesloten · opent om ${start}` };
			}
		}

		for (let i = 1; i <= 7; i++) {
			const nextDay = (day + i) % 7;
			const ranges = schedule[nextDay].hours;
			if (ranges.length) {
				const dayNames = [
					'zondag',
					'maandag',
					'dinsdag',
					'woensdag',
					'donderdag',
					'vrijdag',
					'zaterdag',
				];
				return {
					open: false,
					text: `Nu gesloten · opent ${i === 1 ? 'morgen' : dayNames[nextDay]} om ${ranges[0].split('-')[0]}`,
				};
			}
		}
		return { open: false, text: 'Nu gesloten' };
	}

	const dot = document.getElementById('status-dot');
	const text = document.getElementById('status-text');
	const status = computeStatus();
	if (dot && text) {
		dot.classList.add(status.open ? 'open' : 'closed');
		text.textContent = status.text;
	}
</script>

<style>
	.hero {
		position: relative;
		padding-top: 120px;
		padding-bottom: 120px;
		overflow: hidden;
	}

	.hero-bg {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.hero-overlay {
		position: absolute;
		inset: 0;
		background: linear-gradient(
			120deg,
			rgba(20, 12, 6, 0.86) 0%,
			rgba(20, 12, 6, 0.72) 45%,
			rgba(226, 83, 31, 0.55) 100%
		);
	}

	.hero-content {
		position: relative;
		max-width: 640px;
		color: #fff;
	}

	.eyebrow-light {
		background: rgba(255, 255, 255, 0.16);
		color: #ffe3c2;
	}

	.hero h1 {
		color: #fff;
		font-size: clamp(2.4rem, 5vw, 3.6rem);
		margin: 20px 0 18px;
	}

	.lead {
		font-size: 1.15rem;
		color: rgba(255, 255, 255, 0.88);
		max-width: 520px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 32px;
	}

	.hero-status {
		display: inline-flex;
		align-items: center;
		gap: 10px;
		margin-top: 28px;
		padding: 10px 18px;
		background: rgba(255, 255, 255, 0.12);
		border: 1px solid rgba(255, 255, 255, 0.25);
		border-radius: 999px;
		font-weight: 700;
		font-size: 0.92rem;
	}

	.dot {
		width: 10px;
		height: 10px;
		border-radius: 50%;
		background: #999;
	}

	.dot.open {
		background: #4ade80;
		box-shadow: 0 0 0 4px rgba(74, 222, 128, 0.25);
	}

	.dot.closed {
		background: #f87171;
		box-shadow: 0 0 0 4px rgba(248, 113, 113, 0.2);
	}

	@media (max-width: 640px) {
		.hero {
			padding-top: 96px;
			padding-bottom: 80px;
		}
	}
</style>
