---
import { Image } from 'astro:assets';
import shopPhoto from '../assets/photos/frituur-volledig.jpg';

const ORDER_URL = 'https://frituurhethalfhuis.pickandgo.be/';
---

<section class="hero" id="top">
	<div class="container hero-grid">
		<div class="hero-text">
			<p class="kicker">Frituur &middot; Mielen-Boven-Aalst</p>
			<h1>Frituur Het Halfhuis</h1>
			<p class="lead">
				Verse frieten, snacks en Bicky burgers aan de Borlostraat. Bestel op voorhand via de
				webshop en haal af wanneer het jou past.
			</p>

			<div class="hero-actions">
				<a class="btn btn-primary" href={ORDER_URL} target="_blank" rel="noopener">
					Bestel online
				</a>
				<a class="btn btn-ghost" href="#menu">Bekijk het menu</a>
			</div>

			<p class="hero-status" id="hero-status">
				<span class="dot" id="status-dot"></span>
				<span id="status-text">Openingsuren laden…</span>
			</p>

			<p class="hero-note">100% aanbevolen op Facebook (8 beoordelingen) &middot; afhalen langs de linkse deur</p>
		</div>

		<div class="hero-image">
			<Image src={shopPhoto} alt="De toog van Frituur Het Halfhuis" width={640} height={480} />
		</div>
	</div>
</section>

<script>
	type Hours = { hours: string[] };
	const schedule: Hours[] = [
		{ hours: ['11:30-13:30', '16:30-21:00'] }, // 0 zondag
		{ hours: ['16:30-21:00'] }, // 1 maandag
		{ hours: [] }, // 2 dinsdag
		{ hours: ['11:30-13:30', '16:30-21:00'] }, // 3 woensdag
		{ hours: ['16:30-21:00'] }, // 4 donderdag
		{ hours: ['16:30-21:00'] }, // 5 vrijdag
		{ hours: ['16:30-21:00'] }, // 6 zaterdag
	];

	function toMinutes(t: string) {
		const [h, m] = t.split(':').map(Number);
		return h * 60 + m;
	}

	function computeStatus() {
		const now = new Date();
		const day = now.getDay();
		const nowMin = now.getHours() * 60 + now.getMinutes();
		const todayRanges = schedule[day].hours;

		for (const range of todayRanges) {
			const [start, end] = range.split('-');
			if (nowMin >= toMinutes(start) && nowMin < toMinutes(end)) {
				return { open: true, text: `Nu open · tot ${end}` };
			}
			if (nowMin < toMinutes(start)) {
				return { open: false, text: `Nu gesloten · opent om ${start}` };
			}
		}

		for (let i = 1; i <= 7; i++) {
			const nextDay = (day + i) % 7;
			const ranges = schedule[nextDay].hours;
			if (ranges.length) {
				const dayNames = [
					'zondag',
					'maandag',
					'dinsdag',
					'woensdag',
					'donderdag',
					'vrijdag',
					'zaterdag',
				];
				return {
					open: false,
					text: `Nu gesloten · opent ${i === 1 ? 'morgen' : dayNames[nextDay]} om ${ranges[0].split('-')[0]}`,
				};
			}
		}
		return { open: false, text: 'Nu gesloten' };
	}

	const dot = document.getElementById('status-dot');
	const text = document.getElementById('status-text');
	const status = computeStatus();
	if (dot && text) {
		dot.classList.add(status.open ? 'open' : 'closed');
		text.textContent = status.text;
	}
</script>

<style>
	.hero {
		padding: 56px 0 72px;
	}

	.hero-grid {
		display: grid;
		grid-template-columns: 1.1fr 1fr;
		gap: 56px;
		align-items: center;
	}

	.kicker {
		font-weight: 700;
		font-size: 0.9rem;
		color: var(--color-text-muted);
		text-transform: uppercase;
		letter-spacing: 0.04em;
		margin: 0 0 12px;
	}

	.hero h1 {
		font-size: clamp(2.2rem, 4vw, 3rem);
		margin: 0 0 16px;
	}

	.lead {
		font-size: 1.08rem;
		color: var(--color-text-muted);
		max-width: 480px;
	}

	.hero-actions {
		display: flex;
		flex-wrap: wrap;
		gap: 14px;
		margin-top: 28px;
	}

	.hero-status {
		display: flex;
		align-items: center;
		gap: 9px;
		margin: 22px 0 0;
		font-weight: 700;
		font-size: 0.95rem;
	}

	.dot {
		width: 9px;
		height: 9px;
		border-radius: 50%;
		background: #999;
		flex-shrink: 0;
	}

	.dot.open {
		background: #3aa15c;
	}

	.dot.closed {
		background: #c14a4a;
	}

	.hero-note {
		margin-top: 10px;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.hero-image :global(img) {
		width: 100%;
		height: auto;
		border-radius: var(--radius-lg);
		box-shadow: var(--shadow-soft);
		object-fit: cover;
		aspect-ratio: 4 / 3;
	}

	@media (max-width: 860px) {
		.hero-grid {
			grid-template-columns: 1fr;
			gap: 32px;
		}
		.hero-image {
			order: -1;
		}
	}
</style>
