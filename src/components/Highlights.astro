---
const items = [
	{ icon: '⭐', title: '100% aanbevolen', text: 'Door onze klanten op Facebook (8 beoordelingen en tellen)' },
	{ icon: '🥔', title: 'Dagvers gebakken', text: 'Frietjes en snacks worden bereid zodra jij bestelt' },
	{ icon: '🚪', title: 'Snel afhalen', text: 'Kies je tijdslot online, betaal, en haal af langs de linkse deur' },
	{ icon: '👨‍👩‍👧', title: 'Echte familiezaak', text: 'Gevestigd in het hart van Mielen-Boven-Aalst' },
];
---

<section class="highlights">
	<div class="container grid">
		{items.map((item) => (
			<div class="card">
				<span class="icon">{item.icon}</span>
				<h3>{item.title}</h3>
				<p>{item.text}</p>
			</div>
		))}
	</div>
</section>

<style>
	.highlights {
		padding: 40px 0 0;
		margin-top: -64px;
		position: relative;
		z-index: 2;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 20px;
	}

	.card {
		background: var(--color-bg-alt);
		border-radius: var(--radius-md);
		padding: 26px 22px;
		box-shadow: var(--shadow-soft);
		text-align: left;
	}

	.icon {
		font-size: 1.8rem;
		display: block;
		margin-bottom: 12px;
	}

	.card h3 {
		font-size: 1.05rem;
		margin-bottom: 6px;
	}

	.card p {
		color: var(--color-text-muted);
		font-size: 0.92rem;
	}

	@media (max-width: 900px) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (max-width: 520px) {
		.highlights {
			margin-top: -40px;
		}
		.grid {
			grid-template-columns: 1fr;
		}
	}
</style>
