---
const ORDER_URL = 'https://frituurhethalfhuis.pickandgo.be/';
const navItems = [
	{ href: '#menu', label: 'Menu' },
	{ href: '#over-ons', label: 'Over ons' },
	{ href: '#uren', label: 'Openingsuren' },
	{ href: '#contact', label: 'Contact' },
];
---

<header class="header">
	<div class="container bar">
		<a href="#top" class="logo">
			<span class="logo-mark">🍟</span>
			<span class="logo-text">
				Het <strong>Halfhuis</strong>
			</span>
		</a>

		<nav class="nav" aria-label="Hoofdnavigatie">
			{navItems.map((item) => (
				<a href={item.href}>{item.label}</a>
			))}
		</nav>

		<div class="actions">
			<a class="btn btn-primary" href={ORDER_URL} target="_blank" rel="noopener">
				Bestel online
			</a>
			<button class="burger" id="burger-toggle" aria-label="Menu openen" aria-expanded="false">
				<span></span>
				<span></span>
				<span></span>
			</button>
		</div>
	</div>

	<div class="mobile-nav" id="mobile-nav">
		{navItems.map((item) => (
			<a href={item.href}>{item.label}</a>
		))}
		<a class="btn btn-primary" href={ORDER_URL} target="_blank" rel="noopener">
			Bestel online
		</a>
	</div>
</header>

<script>
	const toggle = document.getElementById('burger-toggle');
	const mobileNav = document.getElementById('mobile-nav');

	toggle?.addEventListener('click', () => {
		const isOpen = mobileNav?.classList.toggle('open');
		toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
	});

	mobileNav?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			mobileNav.classList.remove('open');
			toggle?.setAttribute('aria-expanded', 'false');
		});
	});
</script>

<style>
	.header {
		position: sticky;
		top: 0;
		z-index: 50;
		background: rgba(255, 248, 238, 0.88);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--color-border);
	}

	.bar {
		display: flex;
		align-items: center;
		justify-content: space-between;
		height: 76px;
	}

	.logo {
		display: flex;
		align-items: center;
		gap: 10px;
		font-family: 'Fredoka', system-ui, sans-serif;
		font-size: 1.2rem;
		color: var(--color-dark);
	}

	.logo-mark {
		font-size: 1.6rem;
	}

	.logo-text strong {
		color: var(--color-primary);
	}

	.nav {
		display: flex;
		gap: 32px;
	}

	.nav a {
		font-weight: 700;
		font-size: 0.98rem;
		color: var(--color-text);
		position: relative;
		padding: 6px 2px;
	}

	.nav a:hover {
		color: var(--color-primary-dark);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 14px;
	}

	.burger {
		display: none;
		flex-direction: column;
		justify-content: center;
		gap: 5px;
		width: 42px;
		height: 42px;
		border-radius: 12px;
		border: 1px solid var(--color-border);
		background: #fff;
		cursor: pointer;
	}

	.burger span {
		display: block;
		width: 20px;
		height: 2px;
		margin: 0 auto;
		background: var(--color-dark);
		border-radius: 2px;
	}

	.mobile-nav {
		display: none;
		flex-direction: column;
		gap: 4px;
		padding: 12px 24px 20px;
		background: var(--color-bg-alt);
		border-bottom: 1px solid var(--color-border);
	}

	.mobile-nav.open {
		display: flex;
	}

	.mobile-nav a {
		padding: 12px 4px;
		font-weight: 700;
		border-bottom: 1px solid var(--color-border);
	}

	.mobile-nav .btn {
		margin-top: 12px;
	}

	@media (max-width: 860px) {
		.nav {
			display: none;
		}
	}

	@media (max-width: 640px) {
		.actions .btn-primary {
			display: none;
		}
		.burger {
			display: flex;
		}
	}
</style>
