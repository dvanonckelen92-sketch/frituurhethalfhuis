---
import Header from './Header.astro';
import Footer from './Footer.astro';

interface Props {
	heading: string;
	updated: string;
}

const { heading, updated } = Astro.props;
---

<Header />
<main>
	<section class="section legal">
		<div class="container legal-container">
			<h1>{heading}</h1>
			<p class="updated">Laatst bijgewerkt: {updated}</p>
			<div class="prose">
				<slot />
			</div>
		</div>
	</section>
</main>
<Footer />

<style>
	.legal {
		padding-top: 56px;
	}

	.legal-container {
		max-width: 760px;
	}

	.legal h1 {
		font-size: clamp(1.8rem, 3.4vw, 2.4rem);
	}

	.updated {
		margin-top: 10px;
		color: var(--color-text-muted);
		font-size: 0.9rem;
	}

	.prose {
		margin-top: 32px;
		display: flex;
		flex-direction: column;
		gap: 22px;
	}

	.prose :global(h2) {
		font-size: 1.25rem;
		margin-top: 8px;
	}

	.prose :global(p),
	.prose :global(li) {
		color: var(--color-text-muted);
		line-height: 1.65;
	}

	.prose :global(ul) {
		margin: 0;
		padding-left: 20px;
		display: flex;
		flex-direction: column;
		gap: 8px;
	}

	.prose :global(a) {
		font-weight: 700;
		color: var(--color-primary-dark);
	}

	.prose :global(strong) {
		color: var(--color-text);
	}
</style>
